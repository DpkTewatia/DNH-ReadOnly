{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "FileVault": {
    "RootPath": "D:\\SharedFiles",
    "RequestPath": "/files",
    "ServeUnknownFileTypes": true,
    "DefaultContentType": "application/octet-stream",
    "EnableDirectoryBrowsing": false,
    "ForceDownload": false,
    "IncludeHiddenFiles": false,
    "AllowedExtensions": [],
    "BlockedExtensions": [ ".config", ".exe", ".dll", ".ps1", ".bat", ".cmd", ".pfx", ".key" ],
    "CacheMaxAgeSeconds": 0,
    "ContentTypeMappings": {
      ".log": "text/plain"
    },
    "HealthPath": "/healthz"
  }
}
