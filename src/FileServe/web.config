<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- inheritInChildApplications="false" stops these settings leaking into any
       application nested under this one in IIS. -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <handlers>
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- processPath/arguments are rewritten by `dotnet publish` to match the
           deployment mode (framework-dependent vs self-contained). -->
      <aspNetCore processPath="dotnet"
                  arguments=".\FileServe.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Overrides appsettings.json without editing it. Double underscore is the
               nesting separator, so this is the FileVault:RootPath setting. -->
          <!-- <environmentVariable name="FileVault__RootPath" value="D:\SharedFiles" /> -->
        </environmentVariables>
      </aspNetCore>

      <!-- Without PassThrough, IIS replaces the app's 404 body with its own error page. -->
      <httpErrors existingResponse="PassThrough" />

      <security>
        <requestFiltering>
          <!-- maxAllowedContentLength applies to uploads only; downloads are unlimited.
               maxUrl/maxQueryString are raised for deeply nested folder paths. -->
          <requestLimits maxAllowedContentLength="104857600" maxUrl="8192" maxQueryString="4096" />
          <fileExtensions allowUnlisted="true" />
          <hiddenSegments>
            <!-- IIS blocks these segment names by default. The served folder is arbitrary
                 user content, so a subfolder legitimately named "bin" or "App_Data"
                 must not 404. -->
            <remove segment="bin" />
            <remove segment="App_Data" />
            <remove segment="App_Code" />
          </hiddenSegments>
          <!-- Set allowDoubleEscaping="true" on <requestFiltering> above if file names
               contain a literal '%' character, which reaches IIS as '%25'. -->
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>

    </system.webServer>
  </location>

</configuration>
